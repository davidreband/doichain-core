#!/sbin/openrc-run

# backward compatibility for existing gentoo layout 
#
if [ -d "/var/lib/doichain/.doichain" ]; then
	DOICHAIND_DEFAULT_DATADIR="/var/lib/doichain/.doichain"
else
	DOICHAIND_DEFAULT_DATADIR="/var/lib/doichaind"
fi

DOICHAIND_CONFIGFILE=${DOICHAIND_CONFIGFILE:-/etc/doichain/doichain.conf}
DOICHAIND_PIDDIR=${DOICHAIND_PIDDIR:-/var/run/doichaind}
DOICHAIND_PIDFILE=${DOICHAIND_PIDFILE:-${DOICHAIND_PIDDIR}/doichaind.pid}
DOICHAIND_DATADIR=${DOICHAIND_DATADIR:-${DOICHAIND_DEFAULT_DATADIR}}
DOICHAIND_USER=${DOICHAIND_USER:-${DOICHAIN_USER:-doichain}}
DOICHAIND_GROUP=${DOICHAIND_GROUP:-doichain}
DOICHAIND_BIN=${DOICHAIND_BIN:-/usr/bin/doichaind}
DOICHAIND_NICE=${DOICHAIND_NICE:-${NICELEVEL:-0}}
DOICHAIND_OPTS="${DOICHAIND_OPTS:-${DOICHAIN_OPTS}}"

name="Doichain Core Daemon"
description="Doichain distributed name-value store P2P network daemon"

command="/usr/bin/doichaind"
command_args="-pid=\"${DOICHAIND_PIDFILE}\" \
		-conf=\"${DOICHAIND_CONFIGFILE}\" \
		-datadir=\"${DOICHAIND_DATADIR}\" \
		-daemon \
		${DOICHAIND_OPTS}"

required_files="${DOICHAIND_CONFIGFILE}"
start_stop_daemon_args="-u ${DOICHAIND_USER} \
			-N ${DOICHAIND_NICE} -w 2000"
pidfile="${DOICHAIND_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${DOICHAIND_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${DOICHAIND_USER}:${DOICHAIND_GROUP}" \
	"${DOICHAIND_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${DOICHAIND_USER}:${DOICHAIND_GROUP}" \
	"${DOICHAIND_PIDDIR}"

	checkpath -f \
	-o "${DOICHAIND_USER}:${DOICHAIND_GROUP}" \
	-m 0660 \
	"${DOICHAIND_CONFIGFILE}"

	checkconfig || return 1
}

checkconfig()
{
	if ! grep -qs '^rpcpassword=' "${DOICHAIND_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run doichaind."
		eerror "The setting must appear in ${DOICHAIND_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"Doichain Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
